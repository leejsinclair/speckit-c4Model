#!/usr/bin/env bash
# Run the layout helper's tests before each commit. Enabled by
# scripts/setup-dev.sh, which sets core.hooksPath to this directory.
# The tests use only the Python standard library and take about a second.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python=$(command -v python3 || command -v python || true)
if [ -z "$python" ]; then
  echo "pre-commit: Python 3 not found; cannot run tests/." >&2
  exit 1
fi

if ! out=$("$python" -B -m unittest discover -s tests 2>&1); then
  echo "$out" >&2
  echo "pre-commit: tests failed; commit stopped." >&2
  exit 1
fi
